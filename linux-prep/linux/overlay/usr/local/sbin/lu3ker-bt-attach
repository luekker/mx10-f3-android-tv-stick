#!/bin/sh
# Lu3ker: attach the AIC8800D80 Bluetooth (H4 on UART1, 1.5 Mbaud, no RTS/CTS).
# An attach can get no reply from the chip (BD address stays 00:00:...), seen after a
# previous attach on the same boot; a retry then works. So retry until a real address.
for try in 1 2 3; do
	hciattach -s 1500000 /dev/ttyS1 any 1500000 noflow nosleep >/dev/null 2>&1
	sleep 3
	if hciconfig hci0 2>/dev/null | grep -q 'BD Address: [0-9A-F:]*' &&
	   ! hciconfig hci0 | grep -q 'BD Address: 00:00:00:00:00:00'; then
		echo "Lu3ker: Bluetooth attached on try $try"
		exit 0
	fi
	pkill -x hciattach; sleep 1
done
echo "Lu3ker: Bluetooth controller did not respond" >&2
exit 1
